# Server
NODE_ENV=development
PORT=8000

# Client
CLIENT_URL=http://localhost:5173

# Database
DB_URL=mongodb://localhost:27017/storage-app

# Redis
REDIS_URL=redis://localhost:6379

# OTP
OTP_HMAC_SECRET=replace-with-a-long-random-string

# Session
SESSION_SECRET=replace-with-a-long-random-string

# OAuth pending-signup token
OAUTH_SIGNUP_SECRET=replace-with-a-long-random-string

# Pending-login (session limit) token
PENDING_LOGIN_SECRET=replace-with-a-long-random-string

# GitHub OAuth state (CSRF) token
GITHUB_OAUTH_STATE_SECRET=replace-with-a-long-random-string

# TOTP secret encryption key (32-byte hex, e.g. `openssl rand -hex 32`)
TOTP_ENCRYPTION_KEY=replace-with-a-64-character-hex-string

# Email
EMAIL_PROVIDER=nodemailer
EMAIL_FROM=ProCloudd <no-reply@example.com>

# Nodemailer (SMTP)
NODEMAILER_HOST=smtp.example.com
NODEMAILER_PORT=587
NODEMAILER_USER=your-smtp-user
NODEMAILER_PASSWORD=your-smtp-password

# Resend
RESEND_API_KEY=your-resend-api-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# AWS S3 (file storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=your-s3-bucket-name
