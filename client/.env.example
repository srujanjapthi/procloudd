# In production this must be a relative path (e.g. /api/v1), not the full Render
# URL. When deployed on Netlify, _redirects proxies it to the server so the
# browser sees a same-origin request and the session cookie isn't treated as a
# third-party cookie (which Safari/Firefox/strict Chrome settings block).
VITE_API_URL='http://localhost:8000/api/v1'

VITE_GOOGLE_CLIENT_ID='your-google-oauth-client-id'
